# Local development runs WITHOUT cloud sync by default — leave this file empty
# and `npm run dev` uses browser localStorage with the fictional demo class.
#
# Do not put production keys here. See "Local development vs. production data"
# in the README:
#   .env                    -> npm run dev        (empty = local mode)
#   .env.cloud.local        -> npm run dev:cloud  (dev Supabase project)
#   .env.production.local   -> npm run build      (prod Supabase project)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
